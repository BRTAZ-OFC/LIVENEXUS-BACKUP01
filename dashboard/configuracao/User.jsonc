{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "channels": {
      "type": "object",
      "description": "Canais vinculados por plataforma. A AUTORIDADE é a verificationProof assinada pelo Worker channel-verify — estes campos são metadados de exibição e NÃO provam posse.",
      "properties": {
        "Twitch": {
          "$ref": "#/$defs/linkedChannel"
        },
        "Kick": {
          "$ref": "#/$defs/linkedChannel"
        },
        "YouTube": {
          "$ref": "#/$defs/linkedChannel"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "linkedChannel": {
      "type": "object",
      "properties": {
        "channelName": {
          "type": "string"
        },
        "channelIdentifier": {
          "type": "string"
        },
        "channelUrl": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "number"
        },
        "verificationProof": {
          "type": "string"
        },
        "challengeKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}