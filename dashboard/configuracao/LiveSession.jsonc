{
  "name": "LiveSession",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "platform": {
      "type": "string",
      "maxLength": 50
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "streamId": {
      "type": "string",
      "maxLength": 100
    },
    "vodId": {
      "type": "string",
      "maxLength": 100
    },
    "vodStatus": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "unavailable"
      ],
      "default": "pending"
    },
    "streamUrl": {
      "type": "string",
      "maxLength": 500
    },
    "thumbnailUrl": {
      "type": "string",
      "maxLength": 500
    },
    "channelName": {
      "type": "string",
      "maxLength": 200
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "duration": {
      "type": "number"
    },
    "views": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}